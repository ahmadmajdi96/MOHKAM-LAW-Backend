# ============================================================================
# Caddy — TLS termination + load balancing
#
# Certificates are obtained and renewed automatically via ACME.
# Upstreams are resolved from Docker's embedded DNS on a 5s refresh, so
# `docker compose up -d --scale api=6` is picked up with no reload.
# ============================================================================

{
	email {$ACME_EMAIL}
	servers {
		trusted_proxies static private_ranges
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "geolocation=(), microphone=(self), camera=(self)"
		-Server
	}
}

{$DOMAIN} {
	import security_headers
	encode zstd gzip

	log {
		output stdout
		format json
		# Auth payloads must never reach the log pipeline.
		request>headers>Authorization delete
		request>headers>Cookie delete
	}

	# Health endpoint stays cheap and unlogged-noise-free for load balancers.
	handle /healthz {
		reverse_proxy {
			dynamic a {
				name api
				port 3000
				refresh 5s
			}
		}
	}

	handle {
		reverse_proxy {
			dynamic a {
				name api
				port 3000
				refresh 5s
			}

			lb_policy least_conn
			lb_try_duration 5s
			lb_try_interval 250ms

			health_uri /healthz
			health_interval 10s
			health_timeout 3s

			# Streamed AI responses must not be buffered.
			flush_interval -1

			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
}

# Object storage on its own host.
#
# Presigned URLs are signed against this hostname (S3_PUBLIC_URL), so the proxy
# must forward the request Host and path UNCHANGED — SigV4 binds the signature
# to both, and any rewrite makes MinIO reject the signature. This is why
# storage is a separate site rather than a /storage path prefix on the API.
storage.{$DOMAIN} {
	import security_headers
	encode zstd gzip

	reverse_proxy minio:9000 {
		# Preserve the Host header MinIO validates the signature against.
		header_up Host {host}
		# Large legal bundles stream through without buffering to disk.
		flush_interval -1
	}
}

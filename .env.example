# ============================================================================
# Mohkam backend — environment
#
# Copy to .env and fill in. Generate every secret with:
#   LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 44
#
# Use that alphanumeric form, NOT `openssl rand -base64`. The Postgres, Redis
# and MinIO passwords are interpolated into connection URLs, and base64's "/"
# and "+" break URL parsing at startup.
#
# .env is gitignored. Never commit real values.
# ============================================================================

# --- Public identity -------------------------------------------------------
DOMAIN=api.mohkam.app
ACME_EMAIL=ops@mohkam.app
APP_URL=https://app.mohkam.app
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=https://app.mohkam.app
LOG_LEVEL=info

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=mohkam
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=mohkam

# --- Redis -----------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME

# --- Object storage (MinIO, S3-compatible) ---------------------------------
MINIO_ROOT_USER=mohkam
MINIO_ROOT_PASSWORD=CHANGE_ME
S3_BUCKET=mohkam
S3_REGION=us-east-1
# Public host for presigned upload/download URLs — the address a BROWSER uses.
# Must be a bare host with no path prefix: presigned URLs are SigV4-signed
# against this host, and Caddy forwards it to MinIO unchanged (see ops/Caddyfile,
# the storage.{DOMAIN} site). A path prefix or host rewrite breaks the signature.
# Local dev without a domain: set to http://minio:9000 (see docker-compose.override.yml).
S3_PUBLIC_URL=https://storage.mohkam.app

# --- Auth ------------------------------------------------------------------
# Must be distinct. Rotating ACCESS invalidates live sessions;
# rotating REFRESH forces every user to log in again.
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
# HMAC key for public document-share tokens (share.$token routes).
DOCUMENT_SHARE_SECRET=CHANGE_ME

# --- AI: Novita (OpenAI-compatible) ----------------------------------------
NOVITA_API_KEY=
AI_GATEWAY_BASE_URL=https://api.novita.ai/v3/openai
AI_MODEL=meta-llama/llama-3.3-70b-instruct
AI_EMBEDDING_MODEL=baai/bge-m3

# --- Speech-to-text: ElevenLabs Scribe -------------------------------------
# Server-only. Required by /api/public/elevenlabs/{scribe-token,transcribe}.
# Leave blank to disable STT; those routes will return 503.
ELEVENLABS_API_KEY=

# --- Telephony: Twilio (SMS + WhatsApp) ------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# --- Workers ---------------------------------------------------------------
WORKER_CONCURRENCY=8

# --- Observability ---------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_ROOT_URL=https://grafana.mohkam.app
